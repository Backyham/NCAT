# Virtual environments and local toolchains
.venv*/
.tools/
.kilo/

# Python bytecode
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Runtime state and generated corpora
data/
downloads/
eval_out/
corpus/
*.log

# Ground Truth media and subtitle sources (large, per-machine)
GT/

# Documents - Do not remove, might contain sensitive materials that should not be committed
docs/

# Test scripts - build tools, no need to commit
tests/

# Local ASR backend scripts (not shipped)
ncat/test/

# Legacy CLI restored from 6397165; local behavior reference only, not shipped.
legacy/

# Model weights and local model directories
models/
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx

# Vendored third-party bundle, fetched rather than committed.
# See static/vendor/README.md.
static/vendor/*.js

# Frontend build toolchain; web/dist is produced at release time.
node_modules/
web/dist/
.vite/

# Machine-provisioning scripts (local only)
setup*.sh
pget.sh
